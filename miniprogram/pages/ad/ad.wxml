<view class="container ad-container">
  <view class="ad-card">
    <view class="ad-icon">📺</view>
    <text class="ad-title">获取识别额度</text>
    
    <!-- 广告方式（有广告位时显示） -->
    <block wx:if="{{canUseAd}}">
      <text class="ad-desc">观看 30 秒广告，即可获得 3 次识别额度</text>
      <view class="ad-reward">
        <text class="reward-label">观看奖励</text>
        <view class="reward-item">
          <text class="reward-icon">⚡</text>
          <text class="reward-text">+3 次识别额度</text>
        </view>
      </view>
      <button class="btn-primary" bindtap="showAd" disabled="{{adLoading}}">
        {{adLoading ? '加载中...' : '观看广告'}}
      </button>
    </block>

    <!-- 兜底方式（无广告位时显示） -->
    <block wx:else>
      <text class="ad-desc">广告功能暂未开通，点击按钮直接获取额度</text>
      <view class="notice-box">
        <text class="notice-text">💡 小程序累计访客达到500人后，可开通流量主接入真实广告</text>
      </view>
      <view class="ad-reward">
        <text class="reward-label">今日奖励</text>
        <view class="reward-item">
          <text class="reward-icon">🎁</text>
          <text class="reward-text">+3 次识别额度</text>
        </view>
      </view>
      <button class="btn-success" bindtap="addQuotaDirectly" disabled="{{adLoading}}">
        {{adLoading ? '领取中...' : '免费领取额度'}}
      </button>
    </block>
    
    <view class="ad-hint" wx:if="{{adHint}}">
      <text>{{adHint}}</text>
    </view>
  </view>

  <!-- 其他获取方式 -->
  <view class="ad-card other-card">
    <text class="ad-title">其他获取方式</text>
    <view class="other-item">
      <text class="other-icon">🎁</text>
      <view class="other-info">
        <text class="other-name">每日登录</text>
        <text class="other-desc">每日首次登录自动获得 1 次</text>
      </view>
    </view>
    <view class="other-item">
      <text class="other-icon">👋</text>
      <view class="other-info">
        <text class="other-name">新用户注册</text>
        <text class="other-desc">首次使用赠送 3 次</text>
      </view>
    </view>
  </view>

  <!-- 广告位开通说明 -->
  <view class="ad-card help-card">
    <text class="ad-title">如何开通真实广告？</text>
    <view class="help-step">
      <text class="step-num">1</text>
      <text class="step-text">小程序累计独立访客(UV)达到 500 人</text>
    </view>
    <view class="help-step">
      <text class="step-num">2</text>
      <text class="step-text">登录微信公众平台 → 流量主 → 申请开通</text>
    </view>
    <view class="help-step">
      <text class="step-num">3</text>
      <text class="step-text">创建激励视频广告位，获取 adUnitId</text>
    </view>
    <view class="help-step">
      <text class="step-num">4</text>
      <text class="step-text">将 adUnitId 填入 pages/ad/ad.js 第22行</text>
    </view>
  </view>
</view>
