.stats-card {
  display: flex;
  justify-content: space-around;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.review-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #F0F7FF 0%, #E8F4FD 100%);
}

.review-entry-title,
.review-entry-desc {
  display: block;
}

.review-entry-title {
  color: #1D39C4;
  font-size: 29rpx;
  font-weight: 600;
}

.review-entry-desc {
  margin-top: 6rpx;
  color: #597EF7;
  font-size: 23rpx;
}

.review-entry-btn {
  flex-shrink: 0;
  padding: 14rpx 22rpx;
  border-radius: 28rpx;
  background: #4A90D9;
  color: #fff;
  font-size: 24rpx;
}

.stat-box {
  text-align: center;
}

.stat-box .stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #4A90D9;
}

.stat-box .stat-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.wrong-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.wrong-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.wrong-source {
  font-size: 24rpx;
  color: #4A90D9;
  background: #E8F4FD;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

.wrong-count {
  font-size: 24rpx;
  color: #FF4D4F;
}

.wrong-question {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.wrong-options {
  margin-bottom: 16rpx;
}

.opt-item {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  font-size: 26rpx;
  color: #666;
}

.opt-key {
  margin-right: 12rpx;
  font-weight: bold;
}

.correct-key {
  color: #52C41A;
}

.wrong-answer {
  margin-bottom: 12rpx;
}

.answer-label {
  font-size: 26rpx;
  color: #666;
}

.answer-value {
  font-size: 28rpx;
  color: #52C41A;
  font-weight: bold;
}

.wrong-explain {
  background: #FFFBE6;
  padding: 16rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.wrong-actions {
  display: flex;
  gap: 16rpx;
}

.action-tag {
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  background: #f5f5f5;
  color: #666;
}

.action-tag.done {
  background: #E6F7ED;
  color: #52C41A;
}

.action-tag.delete {
  background: #FFF2F0;
  color: #FF4D4F;
}

.empty-tip text {
  display: block;
  margin-bottom: 10rpx;
}

.empty-tip text:first-child {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.empty-tip text:nth-child(2) {
  font-size: 26rpx;
  color: #999;
}
