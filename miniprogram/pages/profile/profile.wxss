.profile-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.avatar-box {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-bottom: 16rpx;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
}

.avatar {
  width: 100%;
  height: 100%;
}

.nickname {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.quota-card {
  text-align: center;
  padding: 40rpx 30rpx;
}

.quota-header {
  margin-bottom: 24rpx;
}

.quota-header .title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.quota-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.quota-display {
  margin: 30rpx 0;
}

.quota-circle {
  display: inline-flex;
  align-items: baseline;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 8rpx solid #4A90D9;
  align-items: center;
}

.quota-num {
  font-size: 48rpx;
  font-weight: bold;
  color: #4A90D9;
}

.quota-unit {
  font-size: 24rpx;
  color: #4A90D9;
  margin-left: 4rpx;
}

.quota-rules {
  margin-top: 24rpx;
  text-align: left;
}

.quota-rules text {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.menu-card {
  padding: 0;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.menu-arrow {
  font-size: 28rpx;
  color: #ccc;
}

.version {
  text-align: center;
  font-size: 24rpx;
  color: #ccc;
  margin-top: 40rpx;
}
