.quiz-container {
  padding-bottom: 140rpx;
}

.quiz-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.progress-ring {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4A90D9, #6BA5E7);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.progress-text {
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}

.quiz-info {
  flex: 1;
}

.quiz-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.correct-count {
  font-size: 24rpx;
  color: #666;
}

.question-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.question-number {
  font-size: 24rpx;
  color: #4A90D9;
  margin-bottom: 16rpx;
  font-weight: bold;
}

.question-text {
  font-size: 32rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 30rpx;
  font-weight: 500;
}

.options-list {
  margin-bottom: 20rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  background: #F8F9FA;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.option-item:active {
  background: #E8F4FD;
}

.option-item.selected {
  border-color: #4A90D9;
  background: #E8F4FD;
}

.option-item.correct {
  border-color: #52C41A;
  background: #E6F7ED;
}

.option-item.wrong {
  border-color: #FF4D4F;
  background: #FFF2F0;
}

.option-key {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #E8E8E8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #666;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.option-item.selected .option-key {
  background: #4A90D9;
  color: #fff;
}

.option-item.correct .option-key {
  background: #52C41A;
  color: #fff;
}

.option-item.wrong .option-key {
  background: #FF4D4F;
  color: #fff;
}

.option-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.option-result {
  font-size: 36rpx;
  margin-left: 16rpx;
}

.explanation-card {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #FFFBE6;
  border-radius: 12rpx;
  border: 1rpx solid #FFE58F;
}

.explanation-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.explanation-content {
  margin-bottom: 12rpx;
}

.answer-label {
  font-size: 26rpx;
  color: #666;
}

.answer-value {
  font-size: 28rpx;
  color: #52C41A;
  font-weight: bold;
}

.answer-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
}

.quiz-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  gap: 20rpx;
}

.nav-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 44rpx;
  font-size: 28rpx;
  background: #f5f5f5;
  color: #333;
}

.nav-btn.disabled {
  opacity: 0.4;
}

.nav-btn.primary {
  background: linear-gradient(135deg, #4A90D9, #6BA5E7);
  color: #fff;
}

.nav-btn.success {
  background: linear-gradient(135deg, #52C41A, #73D13D);
  color: #fff;
}
