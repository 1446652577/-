page {
  --primary: #4A90D9;
  --primary-light: #6BA5E7;
  --primary-dark: #357ABD;
  --success: #52C41A;
  --error: #FF4D4F;
  --warning: #FAAD14;
  --bg: #F5F7FA;
  --card-bg: #FFFFFF;
  --text: #333333;
  --text-secondary: #666666;
  --text-light: #999999;
  --border: #E8E8E8;
  --shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.container {
  padding: 30rpx;
  background: var(--bg);
  min-height: 100vh;
}

.card {
  background: var(--card-bg);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow);
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: var(--bg);
  color: var(--primary);
  border-radius: 44rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border: 2rpx solid var(--primary);
}

.btn-success {
  background: linear-gradient(135deg, var(--success) 0%, #73D13D 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border: none;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text);
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}

.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.empty-tip {
  text-align: center;
  padding: 100rpx 40rpx;
  color: var(--text-light);
  font-size: 28rpx;
}

.empty-tip image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.quota-badge {
  display: inline-flex;
  align-items: center;
  background: linear-gradient(135deg, #FFF7E6 0%, #FFF0D1 100%);
  color: var(--warning);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.quota-badge .icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}
